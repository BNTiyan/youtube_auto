{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "api/video-request.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/video-request", "dest": "api/video-request.js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
